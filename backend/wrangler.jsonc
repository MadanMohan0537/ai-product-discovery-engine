{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-product-discovery-engine",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../apps/web", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "vars": { "ALLOWED_ORIGINS": "http://localhost:8787" },
  "d1_databases": [{ "binding": "DB", "database_name": "discovery-engine-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
